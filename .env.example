# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Database
DATABASE_URL=postgres://autocheck:autocheck_pass@localhost:5432/autocheck_db
POSTGRES_USER=autocheck
POSTGRES_PASSWORD=autocheck_pass
POSTGRES_DB=autocheck_db

# Redis
REDIS_URL=redis://localhost:6379

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_ATTEMPTS=5

# Gemini (NO EXPOSE IN FRONTEND)
GEMINI_API_KEY=
