# App
NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS. Separar con comas para Vercel production + previews.
FRONTEND_URL=http://localhost:5173
# En producción con dominios distintos usar none/true. En local dejar lax/false.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Ruta persistente para fotos. En local se usa ./backend/uploads.
UPLOADS_DIR=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Database
# En Supabase usar la cadena de conexión directa con ?sslmode=require para migraciones.
# La app puede usar el pooler; evita prepared statements si usas modo transaction.
DATABASE_URL=postgres://autocheck:autocheck_pass@localhost:5432/autocheck_db
POSTGRES_USER=autocheck
POSTGRES_PASSWORD=autocheck_pass
POSTGRES_DB=autocheck_db

# Redis
REDIS_URL=redis://localhost:6379

# Security
BCRYPT_ROUNDS=12
# Solo desarrollo: muestra el código de recuperación en la respuesta de la API
PASSWORD_RESET_SHOW_CODE=true

# Gemini (NO EXPOSE IN FRONTEND)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# API Ninjas Cars (NO EXPOSE IN FRONTEND)
API_NINJAS_KEY=
